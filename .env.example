# ------------------------------------------------------------------------------
# Foodzie Global Environment Variables (Example)
# ------------------------------------------------------------------------------

# --- Backend Configuration ---
# 1. Server Configuration
PORT=5000

# 2. Database Connection
# Replace with your PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/foodzie?schema=public"

# 3. Redis Connection
# Replace with your Redis server URL (e.g., redis://localhost:6379)
REDIS_URL="redis://localhost:6379"

# 4. Security
# Secret for JWT signing
JWT_SECRET="your_jwt_secret_key_here"

# 5. Frontend & API URLs (for CORS, QR codes, receipts, etc.)
# Production URL: https://backend.foodzie.store
API_URL="https://backend.foodzie.store"
# Production URL: https://foodzie.store
FRONTEND_URL="https://foodzie.store"

# --- Frontend Configuration ---
# 1. API Endpoint
# Default for local development: http://localhost:5000
# Production example: https://backend.foodzie.store
NEXT_PUBLIC_API_URL="https://backend.foodzie.store"

# 2. Frontend URL (Used for QR Codes and deep links)
# Default for local development: http://localhost:3000
# Production example: https://foodzie.store
NEXT_PUBLIC_FRONTEND_URL="https://foodzie.store"
