generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String      @id @default(uuid())
  name              String
  email             String      @unique
  password          String
  phone             String?
  profilePicUrl     String?
  universityId      String?
  createdAt         DateTime    @default(now())
  employerId        String?
  lat               Float?
  leaveReason       String?
  lng               Float?
  resignRequest     Boolean     @default(false)
  upi               String?
  vendorDescription String?
  vendorUpi         String?
  workStatus        String      @default("Active")
  role              String      @default("Student")
  earnedCredits Float @default(0)
  refundedCredits Float @default(0)
  resetToken        String?     @db.Text
  resetTokenExpiry  DateTime?
  categories        Category[]
  ordersPlaced      Order[]     @relation("CustomerOrders")
  deliveries        Order[]     @relation("DeliveryOrders")
  ordersReceived    Order[]     @relation("VendorOrders")
  reviews           Review[]    @relation("CustomerReviews")
  university University? @relation(fields: [universityId], references: [id])
  withdrawals WithdrawalRequest[]
}

model University {
  id       String  @id @default(uuid())
  name     String  @unique
  address  String?
  areaName String?
  city     String?
  country  String?
  lat      Float?
  lng      Float?
  users    User[]
}

model Category {
  id       String     @id @default(uuid())
  name     String
  vendorId String
  vendor   User       @relation(fields: [vendorId], references: [id])
  items    FoodItem[]
}

model FoodItem {
  id              String      @id @default(uuid())
  name            String
  description     String?
  price           Float
  imageUrl        String?
  prepTimeMins    Int         @default(15)
  isCooked        Boolean     @default(true)
  stock           Int?
  discountPercent Float?
  discountStart   DateTime?
  discountEnd     DateTime?
  categoryId      String
  isVegetarian    Boolean     @default(true)
  realPrice       Float?
  category        Category    @relation(fields: [categoryId], references: [id])
  orderItems      OrderItem[]
  reviews         Review[]    @relation("FoodItemReviews")
}

model Order {
  id               String      @id @default(uuid())
  customerId       String
  vendorId         String
  deliveryPersonId String?
  totalAmount      Float
  deliveryAddress  String
  isCOD            Boolean     @default(false)
  paymentReceived  Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  status           String      @default("Pending")
  scheduledTime    DateTime?
  customer         User        @relation("CustomerOrders", fields: [customerId], references: [id])
  deliveryPerson   User?       @relation("DeliveryOrders", fields: [deliveryPersonId], references: [id])
  vendor           User        @relation("VendorOrders", fields: [vendorId], references: [id])
  items            OrderItem[]
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  foodItemId  String
  quantity    Int
  priceAtTime Float
  foodItem    FoodItem @relation(fields: [foodItemId], references: [id])
  order       Order    @relation(fields: [orderId], references: [id])
}

model Review {
  id         String    @id @default(uuid())
  rating     Int
  comment    String?
  studentId  String
  canteenId  String?
  foodItemId String?
  orderId    String?
  type       String
  createdAt  DateTime  @default(now())
  foodItem   FoodItem? @relation("FoodItemReviews", fields: [foodItemId], references: [id])
  student    User      @relation("CustomerReviews", fields: [studentId], references: [id])
}

model JobVacancy {
  id          String   @id @default(uuid())
  vendorId    String
  title       String
  description String?
  salary      String?
  createdAt   DateTime @default(now())
}

model JobApplication {
  id          String   @id @default(uuid())
  vacancyId   String
  studentId   String
  name        String
  age         Int
  city        String
  collegeName String
  upiId       String
  address     String
  picUrl      String?
  status      String   @default("Pending")
  createdAt   DateTime @default(now())
}

model CashDeposit {
  id        String   @id @default(uuid())
  riderId   String
  vendorId  String
  amount    Float
  status    String   @default("Pending")
  createdAt DateTime @default(now())
}

model SquadCart {
  id        String          @id @default(uuid())
  vendorId  String
  creatorId String
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  items     SquadCartItem[]
}

model SquadCartItem {
  id         String    @id @default(uuid())
  cartId     String
  foodItemId String
  quantity   Int
  addedById  String
  cart       SquadCart @relation(fields: [cartId], references: [id])
}

model WithdrawalRequest {
  id        String   @id @default(uuid())
  studentId String
  amount    Float
  upiId     String
  status    String   @default("Pending")
  createdAt DateTime @default(now())
  student   User     @relation(fields: [studentId], references: [id])
}
